rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated();
    }

    // Posts — authenticated users can submit (pending only), admins manage all
    match /posts/{id} {
      allow read: if isAuthenticated();
      allow create: if (isAuthenticated() && request.resource.data.status == 'pending') || isAdmin();
      allow update, delete: if isAdmin();
    }

    // Submissions — authenticated users can create, admins manage
    match /submissions/{id} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // Settings — authenticated users can read and write
    match /settings/{id} {
      allow read, write: if isAuthenticated();
    }

    // Locations — authenticated read, admin write
    match /locations/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Trips — authenticated read, admin write
    match /trips/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Registrations — users create/read their own; admins manage all
    match /registrations/{id} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read: if isAuthenticated() &&
        (isAdmin() || resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // User profiles — users manage their own; admins can do everything
    match /userProfiles/{uid} {
      allow get, write: if isAuthenticated() && request.auth.uid == uid;
      allow list, get, write, delete: if isAdmin();
    }
  }
}
