rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/settings/main) &&
        'adminUids' in get(/databases/$(database)/documents/settings/main).data &&
        request.auth.uid in get(/databases/$(database)/documents/settings/main).data.adminUids;
    }

    // Posts — authenticated users can submit (pending only), admins manage all
    match /posts/{id} {
      allow read: if isAuthenticated();
      allow create: if (isAuthenticated() && request.resource.data.status == 'pending') || isAdmin();
      allow update, delete: if isAdmin();
    }

    // Submissions — authenticated users can create, admins manage
    match /submissions/{id} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // Settings — authenticated read; write rules avoid circular get() by using resource.data
    match /settings/{id} {
      allow read: if isAuthenticated();
      allow write: if
        // Existing admin: check via resource.data (avoids get() on the doc being written)
        (isAuthenticated() && resource != null &&
         'adminUids' in resource.data &&
         request.auth.uid in resource.data.adminUids) ||
        // Bootstrap: no admins set up yet
        (resource == null ||
         !('adminUids' in resource.data) ||
         resource.data.adminUids.size() == 0) ||
        // Self-promotion: authenticated user adding only their own UID to adminUids
        (isAuthenticated() && resource != null &&
         'adminUids' in resource.data &&
         resource.data.adminUids.size() > 0 &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminUids']) &&
         request.resource.data.adminUids.hasAll(resource.data.adminUids) &&
         request.auth.uid in request.resource.data.adminUids);
    }

    // Locations — authenticated read, admin write
    match /locations/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Trips — authenticated read, admin write
    match /trips/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Registrations — users create/read their own; admins manage all
    match /registrations/{id} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read: if isAuthenticated() &&
        (isAdmin() || resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // User profiles — users manage their own; admins can do everything
    match /userProfiles/{uid} {
      allow get, write: if isAuthenticated() && request.auth.uid == uid;
      allow list, get, write, delete: if isAdmin();
    }
  }
}
